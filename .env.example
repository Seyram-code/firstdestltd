# Public canonical URL used by metadata, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional: only needed if the map integration is upgraded to use the Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Contact-form email delivery through Hostinger SMTP
# Use the full Hostinger mailbox address and its mailbox password.
# Keep SMTP_PASSWORD private; never commit it.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@firstdestltd.com
SMTP_PASSWORD=
SMTP_FROM=info@firstdestltd.com
CONTACT_EMAIL_TO=info@firstdestltd.com

# AI website assistant. Keep the provider key server-side and never expose it in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible provider endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
